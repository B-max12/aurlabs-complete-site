# Copy to .env.local for local work. On Vercel, add these in Project Settings -> Environment Variables.
# Never commit real values.

# Supabase project (public values; safe to expose to the browser)

# SECRET: Supabase connection string (Project -> Connect -> Transaction pooler, port 6543)
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# SECRET: random string of 32+ characters. Used once to create the first admin account.
AUR_ADMIN_SETUP_TOKEN=REPLACE_WITH_A_LONG_RANDOM_STRING_32_PLUS_CHARS

# Optional: visitor sign-in on the public site (public values; defaults are built into the code)
# NEXT_PUBLIC_SUPABASE_URL=https://zitgifdbkpvdrgpvczle.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Fk0YvX-4fPS3Cqly8CqF5Q_hv6vyeeO
# Local development only: DB_SSL=off

# Email notifications for form submissions (Resend)
RESEND_API_KEY=re_FAKE_EXAMPLE_KEY
MAIL_FROM=Aur Labs <noreply@aurlabs.online>
MAIL_TO=aur@aurlabs.online
