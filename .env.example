# Production v2 uses this setup secret only during first admin enrollment.
# This is deliberately FAKE. Never use it for a real deployment.
AUR_ADMIN_SETUP_TOKEN=FAKE_LOCAL_EXAMPLE_DO_NOT_USE_IN_PRODUCTION_000000000000

# DB and BUCKET are Cloudflare resource bindings, not string environment variables.
# The one-command local launcher creates its own random .dev.vars securely.
# Production runtime revision 2 had no configured variable entries at export.
# Supabase variables belong only to the separate unreleased archive, not this app.
